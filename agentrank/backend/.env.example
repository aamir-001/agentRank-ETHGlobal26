GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=../../gcp-service-account.json
DATABASE_URL="file:./dev.db"
PORT=3001

# Optional: Ethereum mainnet RPC URL used for ENS resolution (forward/reverse
# lookups + text records). If unset, falls back to ethers' public default
# provider (lower rate limits).
ETH_RPC_URL=

# ENS Passport settings (suggested subname + records for the passport feature)
ENS_PARENT_NAME=agentrank.eth
PUBLIC_APP_URL=https://agentrank.xyz

# World ID — proof-of-personhood (create an app at developer.worldcoin.org; use
# a staging app for the simulator). Two distinct actions, two trust axes:
#   - WORLD_ID_ACTION       weights on-chain feedback (rater personhood)
#   - WORLD_ID_OWNER_ACTION  bonus for agents owned by a verified human (operator)
# Keep them separate so one human can verify both a rater and an owner wallet.
WORLD_ID_APP_ID=
WORLD_ID_ACTION=agentrank-rater
WORLD_ID_OWNER_ACTION=agentrank-owner
# AgentKit human-backed agents (Delegated World ID). One human can back MANY
# agents, so create this action with UNLIMITED verifications per person.
WORLD_ID_AGENT_ACTION=agentrank-agent
# RP (relying-party) signing context for IDKit 4.0. The signing key never leaves
# the server. Use a throwaway key for the demo.
WORLD_ID_RP_ID=
WORLD_ID_RP_SIGNING_KEY=
